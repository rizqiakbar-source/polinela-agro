{
    "name": "polinela/agro-digital",
    "type": "project",
    "description": "Aplikasi E-Commerce Produk Perkebunan Berbasis Web di Politeknik Negeri Lampung",
    "homepage": "https://polinela.ac.id",
    "license": "MIT",
    "require": {
        "php": "^8.1 || ^8.2",
        "codeigniter4/framework": "^4.5",
        "dompdf/dompdf": "^2.0 || ^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
